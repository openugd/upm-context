<!--
  IL2CPP / managed-stripping preservation.

  This package activates services with reflection (ConstructorInfo.Invoke, FieldInfo.SetValue), so the
  members it calls must survive the managed linker. Preserving THIS assembly is not enough on its own:
  the linker strips the *consumer's* service types, and this file cannot name types it has never seen.

  For your own services, do one of:
    * mark them [OpenUGD.Preserve]  - Unity's linker matches that attribute BY NAME, so it works even
      though this package has no UnityEngine reference; or
    * list them in your own project's link.xml; or
    * register them with a hand-written factory - services created by
      `Add<T>(c => new T(c.Resolve<IDep>()))` use no reflection at all and are therefore always safe.
-->
<linker>
  <assembly fullname="com.openugd.context" preserve="all" />
</linker>
